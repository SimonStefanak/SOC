# Copy this file to ".env" (next to manage.py) and fill in the values.
# On a server you can set these as real environment variables instead.

# Long random string, unique per server. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# True only on your own computer. Leave False (or remove the line) on a server.
DJANGO_DEBUG=False

# Comma-separated domain names the site is served from.
DJANGO_ALLOWED_HOSTS=booklog.example.com

# Comma-separated full https origins (needed for logging in over https).
DJANGO_CSRF_TRUSTED_ORIGINS=https://booklog.example.com

# True when a proxy/host terminates https in front of Django (nginx, Render, PythonAnywhere...).
DJANGO_BEHIND_HTTPS_PROXY=False

# Optional, production only (used when DJANGO_DEBUG is False):
# DJANGO_SECURE_SSL_REDIRECT=True          # set False if the host already redirects http -> https
# DJANGO_SECURE_HSTS_SECONDS=3600          # raise to 31536000 once https works
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
